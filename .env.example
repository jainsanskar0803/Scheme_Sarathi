# ── AI / Speech ───────────────────────────────────────────────────────────────
# Sarvam AI — used for STT, TTS, multilingual chat, and document verification
# Get your key at: https://dashboard.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here

# ── Database ──────────────────────────────────────────────────────────────────
# Supabase — stores interview sessions and all 3,397 government schemes
# Get these from: Supabase dashboard → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# Set to "true" to use Supabase (production).
# Set to "false" to use the 14-scheme local JSON fallback (no DB needed).
USE_SUPABASE=true
